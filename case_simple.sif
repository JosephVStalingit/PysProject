! ------------------------------------------------------------------
!  case_simple.sif  --  3D magnetostatic sanity test for Elmer 26.2.
!
!  STATUS (as of 2026-09-10):
!      Elmer 26.2 was compiled successfully from source with
!      MSYS2 (gcc 16.1.0, gfortran 16.1.0, cmake 4.3.3, ninja 1.13.2)
!      using openblas from the Elmer 26.1 installation as
!      BLAS/LAPACK provider.  The binaries were staged at
!      C:\elmer262\bin\ElmerSolver.exe and C:\elmer262\bin\ElmerGrid.exe.
!
!      ElmerSolver now loads the procedure DLL (MagnetoDynamics) but
!      rejects the "Magnetic Vector Potential 1/2/3" specifier pair in
!      the Initial Condition section.  The SOLVER.KEYWORDS only registers
!      these keywords under "BC:Real:" -- they are NOT InitialCondition
!      keywords.  The Initial Condition block is therefore dropped; the
!      static solver starts from zero automatically.
! ------------------------------------------------------------------

Header
  Mesh DB "c:\Users\JosephVStalin\Desktop\PysProject" "mesh"
  Include Path ""
  Results Directory "c:\Users\JosephVStalin\Desktop\PysProject\results"
End

Simulation
  Max Output Level       = 8
  Coordinate System      = Cartesian
  Coordinate Mapping(3)  = 1 2 3
  Simulation Type        = Steady
  Steady State Max Iterations = 1
  Output Intervals       = 1
  Post File              = case.vtu
  Use Mesh Names         = False
End

! ============================================================
! Equation block - single MagnetoDynamics solver.
! ============================================================
Equation 1
  Name = "MagneticsOnly"
  Active Solvers(1) = 1
End

! ---------- Solver 1 : MagnetoDynamics 3D ----------
!  Keywords `Magnetic Vector Potential` (vector 3) and
!  `Magnetic Vector Potential 1/2/3` (component-wise) are registered
!  in share/elmersolver/lib/SOLVER.KEYWORDS under procedure
!  "MagnetoDynamics".  The SIF below uses the compact vector form.
!  If the procedure DLL cannot be loaded, the keyword falls back to
!  the scalar `AV` (1 component) and the load aborts with
!  "Mismatch of declared and given dimension for keyword".
! ----------------------------------------------------------------
Solver 1
  Exec Solver = Always
  Equation = "MGDynamics"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Variable = "Magnetic Vector Potential"

  Use Piola Transform = Logical true
  Use Tree Gauge = Logical False

  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
  Linear System Iterative Method = BiCGStab
  Linear System Preconditioning = ILU
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Max Iterations = 1000

  Nonlinear System Max Iterations = 4
  Nonlinear System Convergence Tolerance = 1.0e-7
  Steady State Convergence Tolerance = 1.0e-5

  Calculate Current Density       = True
  Calculate Magnetic Flux Density = True
  Calculate Magnetic Field Strength = True
End

! ---------- Solver 2 : save results ----------
Solver 2
  Exec Solver = After all
  Equation = "ResultOutput"
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = case
  VTU Format = Logical True
End

! ============================================================
!  Materials
! ============================================================
Material 1
  Name = "CoilWinding"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

Material 2
  Name = "NdFeBMagnet"
  Relative Permeability = 1.05
  Electric Conductivity = 1.0e-12
End

Material 3
  Name = "Air"
  Relative Permeability = 1.0
  Electric Conductivity = 1.0e-12
End

! ============================================================
!  Body force -- drives a uniform current density through
!  the coil winding (Body 1) so that the magnetostatic
!  solution is non-trivial.
! ============================================================
Body Force 1
  Name = "CoilCurrent"
  Current Density 1 = 0.0
  Current Density 2 = 0.0
  Current Density 3 = 5.0e6
End

! ============================================================
!  Bodies
! ============================================================
Body 1
  Name     = "CoilBlock"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 2
  Name     = "Magnet"
  Equation = 1
  Material = 2
End

Body 3
  Name     = "AirDomain"
  Equation = 1
  Material = 3
End

! ============================================================
!  Boundary
! ============================================================
Boundary Condition 1
  Name = "MagneticInfinity"
  Target Boundaries(1) = 1001
  Magnetic Vector Potential 1 = 0.0
  Magnetic Vector Potential 2 = 0.0
  Magnetic Vector Potential 3 = 0.0
End

! (No Initial Condition block -- not registered for
!  "Magnetic Vector Potential" in SOLVER.KEYWORDS.  The static
!  MagnetoDynamics solver starts from a zero guess.)
