  depfile = $DEP_FILE
  command = C:\msys64\mingw64\bin\cmake.exe -E cmake_ninja_depends --tdi=fem\src\modules\CMakeFiles\EMPort.dir\FortranDependInfo.json --lang=Fortran --src=$in --out=$out --dep=$DEP_FILE --obj=$OBJ_FILE --ddi=$out
