  command = C:\Windows\system32\cmd.exe /C "C:\msys64\mingw64\bin\gfortran.exe -cpp $DEFINES $INCLUDES $FLAGS -E $in -o $out && C:\msys64\mingw64\bin\cmake.exe -E cmake_ninja_depends --tdi=fem\src\modules\CMakeFiles\EMPort.dir\FortranDependInfo.json --lang=Fortran --src=$out --out=$out --dep=$DEP_FILE --obj=$OBJ_FILE --ddi=$DYNDEP_INTERMEDIATE_FILE --src-orig=$in"
  description = Building Fortran preprocessed $out


#############################################
