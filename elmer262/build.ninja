  POST_BUILD = cd .
  PRE_LINK = cd .
  RESTAT = 1
  TARGET_FILE = matc\src\libmatc.dll
  TARGET_IMPLIB = matc\src\libmatc.dll.a
  TARGET_PDB = matc.dll.dbg
  TARGET_SUPPORT_DIR = matc\src\CMakeFiles\matc.dir

